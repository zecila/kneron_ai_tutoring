# Tutor application
FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-a-long-random-value
OPENAI_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1

# Existing external text-to-speech service
AVATAR_ENABLED=true

TTS_BASE_URL=http://replace-with-your-tts-service
TTS_MODEL=indextts1.5
TTS_VERSION=kneo350
TUTOR_TTS_MODEL=indextts1.5
TUTOR_TTS_VERSION=kneo350
TTS_MAX_CHARS_PER_REQUEST=500
TTS_MAX_RETRIES=4
TTS_REQUEST_TIMEOUT=60
TTS_READY_TIMEOUT=300
TTS_RECOVERY_TIMEOUT=45
TTS_RETRY_BASE_DELAY=1
TTS_RETRY_MAX_DELAY=8
TTS_LOCK_WAIT_TIMEOUT=100
TTS_LOCK_TIMEOUT=130
LIVETALKING_HEALTH_TIMEOUT=2

# The browser connects to this host URL, not to a Compose service name.
STT_WEBSOCKET_URL=ws://127.0.0.1:8002/v1/listen?language=en&encoding=linear16&sample_rate=16000&channels=1&interim_results=true&endpointing=1000&vad_events=true

# WhisperLiveKit source and runtime settings
LIVETALKING_PATH=../LiveTalking
WHISPERLIVEKIT_PATH=../WhisperLiveKit
WHISPERLIVEKIT_COMMIT=ed571b69099d089a04f15b7690bbcae6aa2cc54b
WHISPERLIVEKIT_PORT=8002
WHISPERLIVEKIT_EXTRAS=cpu
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_PAUSE_SEGMENTATION_SECONDS=1.0
WHISPER_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
HF_TOKEN=
